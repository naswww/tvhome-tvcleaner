<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF0A84FF" />
            <stroke android:width="3dp" android:color="#FFBFE6FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFB300" />
            <stroke android:width="5dp" android:color="#FFFFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1E6FB0" />
            <stroke android:width="3dp" android:color="#FF8FD3FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C2330" />
            <stroke android:width="1dp" android:color="#FF384556" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
